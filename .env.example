# Copy to .env.local and fill in values from Supabase Dashboard > Project Settings > API.
# Only the PUBLISHABLE key belongs here. Never put a secret / service_role key in a VITE_ variable:
# every VITE_ variable is bundled into browser JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: product name shown in the UI (defaults to LiftFuel).
VITE_APP_NAME=LiftFuel

# Optional, Playwright e2e only: a dedicated test account on a NON-production project.
# E2E_EMAIL=
# E2E_PASSWORD=
